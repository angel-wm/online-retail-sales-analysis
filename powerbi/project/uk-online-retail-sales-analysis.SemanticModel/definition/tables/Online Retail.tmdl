	column Is_Merchandise_Reversal
		dataType: boolean
		lineageTag: d21d402c-2580-5f91-b3e0-7f1314554d8c
		summarizeBy: none
		sourceColumn: Is_Merchandise_Reversal

	column Movement_Type
		dataType: string
		lineageTag: 0504447a-47f4-5650-b22f-6798cd818a9a
		summarizeBy: none
		sourceColumn: Movement_Type

	partition 'Online Retail' = m
		mode: import
		source =
				let
				    Origen = Excel.Workbook(File.Contents("C:\Users\angel\Documents\Courses\DA\proyecto_personal\online+retail\Online Retail.xlsx"), null, true),
				    #"Online Retail_Sheet" = Origen{[Item="Online Retail",Kind="Sheet"]}[Data],
				    #"Encabezados promovidos" = Table.PromoteHeaders(#"Online Retail_Sheet", [PromoteAllScalars=true]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(#"Encabezados promovidos",{{"InvoiceNo", type any}, {"StockCode", type any}, {"Description", type text}, {"Quantity", Int64.Type}, {"InvoiceDate", type datetime}, {"UnitPrice", type number}, {"CustomerID", Int64.Type}, {"Country", type text}}),
				    #"Columnas con nombre cambiado" = Table.RenameColumns(#"Tipo cambiado",{{"InvoiceNo", "Invoice_ID"}, {"StockCode", "Stock_Code"}, {"Description", "Product_Name"}, {"InvoiceDate", "Invoice_Date"}, {"UnitPrice", "Unit_Price"}, {"CustomerID", "Customer_ID"}}),
				    #"Tipo cambiado1" = Table.TransformColumnTypes(#"Columnas con nombre cambiado",{{"Invoice_ID", type text}, {"Stock_Code", type text}, {"Customer_ID", type text}}),
				    #"Filas filtradas" = Table.SelectRows(#"Tipo cambiado1", each ([Product_Name] <> null)),
				    #"Personalizada agregada" = Table.AddColumn(#"Filas filtradas", "Line_Type", each let
				    code = Text.Upper(Text.Trim(Text.From([Stock_Code]))),
				    name = Text.Upper(Text.Trim(Text.From([Product_Name])))
				in
				    if Text.StartsWith(code, "GIFT_") or Text.Contains(name, "GIFT VOUCHER") then "Gift Voucher"
				    else if List.Contains({"M","S","POST","AMAZONFEE","AMAZON FEE","BANK CHARGES","D","DOT","C2","B","CRUK"}, code)
				         or name = "EBAY"
				    then "Adjustment"
				    else "Product"),
				    #"Columna duplicada" = Table.DuplicateColumn(#"Personalizada agregada", "Invoice_Date", "Invoice_Date - Copia"),
				    #"Tipo cambiado2" = Table.TransformColumnTypes(#"Columna duplicada",{{"Invoice_Date - Copia", type date}}),
				    #"Columnas con nombre cambiado1" = Table.RenameColumns(#"Tipo cambiado2",{{"Invoice_Date - Copia", "Invoice_Day"}}),
				    #"Columnas reordenadas" = Table.ReorderColumns(#"Columnas con nombre cambiado1",{"Invoice_ID", "Stock_Code", "Line_Type", "Product_Name", "Quantity", "Invoice_Date", "Invoice_Day", "Unit_Price", "Customer_ID", "Country"}),
				    #"Personalizada agregada1" = Table.AddColumn(#"Columnas reordenadas", "Record_Flag", each let
				    pname = if [Product_Name] = null then "" else Text.Upper(Text.Trim(Text.From([Product_Name]))),
				    custid = if [Customer_ID] = null then "" else Text.Upper(Text.Trim(Text.From([Customer_ID]))),
				    uprice = try Number.From([Unit_Price]) otherwise null,

				    hasCustomer = custid <> "",

				    isManualReview =
				        Text.StartsWith(pname, "*") and not hasCustomer,

				    isOperationalNonProduct =
				        not hasCustomer and
				        (
				            Text.Contains(pname, "?") or
				            Text.Contains(pname, "MISSING") or
				            Text.Contains(pname, "LOST") or
				            Text.Contains(pname, "DAMAGE") or
				            Text.Contains(pname, "DISPLAY") or
				            Text.Contains(pname, "SOLD AS SETS")
				        ) and
				        (uprice = null or uprice = 0)

				in
				    if isManualReview then "Manual / Review"
				    else if isOperationalNonProduct then "Operational / Non-Product"
				    else "Normal"),
				    #"Tipo cambiado3" = Table.TransformColumnTypes(#"Personalizada agregada1",{{"Record_Flag", type text}, {"Line_Type", type text}}),
				    #"Personalizada agregada2" = Table.AddColumn(#"Tipo cambiado3", "Is_Cancelled", each let
				    inv = if [Invoice_ID] = null then "" else Text.Upper(Text.Trim(Text.From([Invoice_ID])))
				in
				    Text.StartsWith(inv, "C")),
				    #"Personalizada agregada3" = Table.AddColumn(#"Personalizada agregada2", "Is_Negative_Qty", each let
				    qty = try Number.From([Quantity]) otherwise null
				in
				    if qty = null then false
				    else qty < 0),
				    #"Personalizada agregada4" = Table.AddColumn(#"Personalizada agregada3", "Is_ZeroPrice", each let
				    price = try Number.From([Unit_Price]) otherwise null
				in
				    if price = null then false
				    else price = 0),
				    #"Personalizada agregada5" = Table.AddColumn(#"Personalizada agregada4", "Sales_Amount", each let
				    qty = try Number.From([Quantity]) otherwise null,
				    price = try Number.From([Unit_Price]) otherwise null
				in
				    if qty = null or price = null then null
				    else Number.Round(qty * price, 2)),
				    #"Tipo cambiado6" = Table.TransformColumnTypes(#"Personalizada agregada5",{{"Is_Cancelled", type text}, {"Is_Negative_Qty", type text}, {"Is_ZeroPrice", type text}, {"Sales_Amount", type number}}),
				    #"Filas filtradas1" = Table.SelectRows(#"Tipo cambiado6", each true),
				    #"Tipo cambiado4" = Table.TransformColumnTypes(#"Filas filtradas1",{{"Is_Cancelled", type text}, {"Is_Negative_Qty", type text}, {"Is_ZeroPrice", type text}, {"Sales_Amount", type number}}),
				    #"Columnas con nombre cambiado2" = Table.RenameColumns(#"Tipo cambiado4",{{"Is_ZeroPrice", "Is_Zero_Price"}}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Columnas con nombre cambiado2",{{"Is_Cancelled", type logical}, {"Is_Negative_Qty", type logical}, {"Is_Zero_Price", type logical}}),
				    #"Added Custom" = Table.AddColumn(#"Changed Type", "Include_In_Main_Analysis", each let
				    line = if [Line_Type] = null then "" else Text.Upper(Text.Trim(Text.From([Line_Type]))),
				    flag = if [Record_Flag] = null then "" else Text.Upper(Text.Trim(Text.From([Record_Flag]))),
				    cancelled = if [Is_Cancelled] = null then false else [Is_Cancelled],
				    negativeQty = if [Is_Negative_Qty] = null then false else [Is_Negative_Qty],
				    zeroprice = if [Is_Zero_Price] = null then false else [Is_Zero_Price]
				in
				    line = "PRODUCT"
				    and flag = "NORMAL"
				    and cancelled = false
				    and [Quantity] > 0
				    and [Unit_Price] > 0),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Added Custom",{{"Include_In_Main_Analysis", type logical}}),
				    #"Merchandise reversals" = Table.AddColumn(#"Changed Type1", "Is_Merchandise_Reversal", each [Line_Type] = "Product" and [Record_Flag] = "Normal" and [Quantity] < 0 and [Unit_Price] > 0, type logical),
				    #"Movement classification" = Table.AddColumn(#"Merchandise reversals", "Movement_Type", each if [Include_In_Main_Analysis] then "Merchandise sale" else if [Is_Merchandise_Reversal] then "Merchandise cancellation / reversal" else if [Line_Type] = "Adjustment" then "Administrative adjustment" else if [Line_Type] = "Gift Voucher" then "Gift voucher movement" else "Other / excluded movement", type text)
				in
				    #"Movement classification"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table
