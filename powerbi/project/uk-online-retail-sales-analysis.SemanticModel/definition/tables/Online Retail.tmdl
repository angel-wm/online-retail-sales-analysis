table 'Online Retail'
	lineageTag: fe13836e-d070-4207-a37c-407e3ad8b915

	measure 'Total Sales' = ROUND(SUM('Online Retail'[Sales_Amount]), 2)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Measures
		lineageTag: 2fcebc02-37b7-4677-ab3e-306ff9a07932

	measure 'Main Sales' =
			
			ROUND(
			    CALCULATE(
			        [Total Sales], 'Online Retail'[Include_In_Main_Analysis] = TRUE()
			    ),
			    2
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Measures
		lineageTag: 5366af5b-86d7-451a-bc14-ae98684b0b62

	measure 'Returns Amount' =
			
			ABS(
			    CALCULATE(
			        [Total Sales], 'Online Retail'[Is_Negative_Qty] = TRUE()
			    )
			)
		displayFolder: Measures
		lineageTag: f0bcc5e3-8614-47af-b20a-80e7c4d27224

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Net Sales' = ROUND([Main Sales] - [Returns Amount], 2)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Measures
		lineageTag: ed3737bf-d45c-4ee7-bdb4-6679b9272a1e

	measure Orders =
			
			CALCULATE(
			    DISTINCTCOUNT('Online Retail'[Invoice_ID]),
			    'Online Retail'[Include_In_Main_Analysis]
			)
		formatString: 0
		displayFolder: Measures
		lineageTag: 6a940080-57fe-4c27-9257-b4d5d5aaea92

	measure 'Unique Customers' =
			
			CALCULATE(
			    DISTINCTCOUNT('Online Retail'[Customer_ID]),
			    'Online Retail'[Include_In_Main_Analysis] = TRUE(),
			    NOT(ISBLANK('Online Retail'[Customer_ID]))
			)
		formatString: 0
		displayFolder: Measures
		lineageTag: e4d73298-4cd5-468b-afc2-7694dd8630bc

	measure 'Average Order Value' = MROUND(DIVIDE([Net Sales], [Orders]), 2)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Measures
		lineageTag: 5b94000b-8315-4e95-aa93-faabe723a1b3

	measure 'Return rate' = ROUND(DIVIDE([Returns Amount], [Main Sales]), 2)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Measures
		lineageTag: 93f39c05-23cb-48cd-90df-1dfb7295b4df

	measure 'Units Sold' =
			
			CALCULATE(
			    SUM('Online Retail'[Quantity]),
			    'Online Retail'[Include_In_Main_Analysis] = TRUE()
			)
		formatString: 0
		displayFolder: Measures
		lineageTag: 2fc54b72-e322-48ad-bd46-03f45c382f5f

	measure 'Cancelled Orders' =
			
			CALCULATE(
			    DISTINCTCOUNT('Online Retail'[Invoice_ID]),
			    'Online Retail'[Is_Cancelled]  = TRUE()
			)
		formatString: 0
		displayFolder: Measures
		lineageTag: b91ab1b2-87b7-40a8-b843-8589533f4083

	measure 'Zero Price Records' =
			
			CALCULATE(
			    COUNTROWS('Online Retail'),
			    'Online Retail'[Is_Zero_Price] = TRUE()
			)
		formatString: 0
		displayFolder: Measures
		lineageTag: 2e876fe8-b36c-4359-a210-c15e5910190e

	measure 'Return Value' =
			
			CALCULATE(
			    SUMX(
			        'Online Retail',
			        ABS('Online Retail'[Sales_Amount])
			    ),
			    'Online Retail'[Is_Negative_Qty] = TRUE(),
			    'Online Retail'[Line_Type] = "Product"
			)
		displayFolder: Measures
		lineageTag: f3674507-6efc-4af5-82d9-abd0c17c2b4b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

