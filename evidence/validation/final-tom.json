        }
      ],
      "measures": [
        {
          "name": "Total Sales",
          "expression": "SUM(\u0027Online Retail\u0027[Sales_Amount])",
          "format": "\u00A3#,0.00;(\u00A3#,0.00);\u00A30.00",
          "description": "Signed total of all loaded movements in the current filter context. Reconciliation measure; GBP."
        },
        {
          "name": "Main Sales",
          "expression": "CALCULATE([Total Sales], KEEPFILTERS(\u0027Online Retail\u0027[Include_In_Main_Analysis] = TRUE()))",
          "format": "\u00A3#,0.00;(\u00A3#,0.00);\u00A30.00",
          "description": "Gross eligible merchandise sales. Product, Normal, quantity and price positive, invoice not cancelled; GBP."
        },
        {
          "name": "Returns Amount",
          "expression": "-CALCULATE([Total Sales], KEEPFILTERS(\u0027Online Retail\u0027[Is_Merchandise_Reversal] = TRUE()))",
          "format": "\u00A3#,0.00;(\u00A3#,0.00);\u00A30.00",
          "description": "Magnitude of negative eligible merchandise movements, counted once. Cancellation/reversal proxy, not proof of physical returns; GBP."
        },
        {
          "name": "Net Sales",
          "expression": "VAR Gross = [Main Sales]\nVAR Reversals = [Returns Amount]\nRETURN\n    IF(ISBLANK(Gross) \u0026\u0026 ISBLANK(Reversals), BLANK(), COALESCE(Gross, 0) - COALESCE(Reversals, 0))",
          "format": "\u00A3#,0.00;(\u00A3#,0.00);\u00A30.00",
          "description": "Gross eligible merchandise sales less merchandise cancellations/reversals. Administrative adjustments and other movements excluded; GBP."
        },
        {
          "name": "Orders",
          "expression": "CALCULATE(DISTINCTCOUNTNOBLANK(\u0027Online Retail\u0027[Invoice_ID]), KEEPFILTERS(\u0027Online Retail\u0027[Include_In_Main_Analysis] = TRUE()))",
          "format": "#,0",
          "description": "Distinct invoices with at least one eligible positive merchandise line. Cancellation invoices excluded. Counts are not additive across products/countries."
        },
        {
          "name": "Unique Customers",
          "expression": "CALCULATE(DISTINCTCOUNTNOBLANK(\u0027Online Retail\u0027[Customer_ID]), KEEPFILTERS(\u0027Online Retail\u0027[Include_In_Main_Analysis] = TRUE()))",
          "format": "#,0",
          "description": "Distinct identified customers with eligible merchandise sales in the current context. Anonymous buyers cannot be counted."
        },
        {
          "name": "Average Order Value",
          "expression": "DIVIDE([Net Sales], [Orders])",
          "format": "\u00A3#,0.00;(\u00A3#,0.00);\u00A30.00",
          "description": "Net merchandise value per eligible sale invoice in the selected period. Reversals are dated at posting, not matched to original orders. Not a physical basket average; GBP."
        },
        {
          "name": "Return rate",
          "expression": "DIVIDE([Returns Amount], [Main Sales])",
          "format": "0.00%;-0.00%;0.00%",
          "description": "Merchandise cancellation/reversal amount divided by gross eligible merchandise sales in the selected period. Posting-period value ratio, not physical return probability; blank if denominator absent."
        },
        {
          "name": "Units Sold",
          "expression": "CALCULATE(SUM(\u0027Online Retail\u0027[Quantity]), KEEPFILTERS(\u0027Online Retail\u0027[Include_In_Main_Analysis] = TRUE()))",
          "format": "#,0",
          "description": "Positive eligible merchandise units. Administrative/gift voucher quantities excluded."
        },
        {
          "name": "Cancelled Orders",
          "expression": "CALCULATE(DISTINCTCOUNTNOBLANK(\u0027Online Retail\u0027[Invoice_ID]), KEEPFILTERS(\u0027Online Retail\u0027[Is_Merchandise_Reversal] = TRUE()))",
          "format": "#,0",
          "description": "Distinct invoices containing eligible negative merchandise movements. All such invoices in this source have prefix C; no claim of physical returns or original-order linkage."
        },
        {
          "name": "Zero Price Records",
          "expression": "CALCULATE(COUNTROWS(\u0027Online Retail\u0027), KEEPFILTERS(\u0027Online Retail\u0027[Is_Zero_Price] = TRUE()))",
          "format": "#,0",
          "description": "Loaded lines with zero unit price. Quality diagnostic across all line types, respecting current filters."
        },
        {
          "name": "Return Value",
          "expression": "[Returns Amount]",
          "format": "\u00A3#,0.00;(\u00A3#,0.00);\u00A30.00",
          "description": ""
        },
        {
          "name": "Administrative Adjustments",
          "expression": "CALCULATE([Total Sales], KEEPFILTERS(\u0027Online Retail\u0027[Line_Type] = \u0022Adjustment\u0022))",
          "format": "\u00A3#,0.00;(\u00A3#,0.00);\u00A30.00",
          "description": "Signed administrative and special-code movements, including commissions, postage, discounts, manual adjustments, samples and bad debt. Not recognized profit or operating expenses; GBP."
        },
        {
          "name": "Other Movements",
          "expression": "CALCULATE([Total Sales], KEEPFILTERS(\u0027Online Retail\u0027[Movement_Type] IN {\u0022Gift voucher movement\u0022, \u0022Other / excluded movement\u0022}))",
          "format": "\u00A3#,0.00;(\u00A3#,0.00);\u00A30.00",
          "description": "Signed gift voucher and residual excluded movements. Completes the bridge Net Sales \u002B Administrative Adjustments \u002B Other Movements = Total Sales; GBP."
        },
        {
          "name": "Units Reversed",
          "expression": "-CALCULATE(SUM(\u0027Online Retail\u0027[Quantity]), KEEPFILTERS(\u0027Online Retail\u0027[Is_Merchandise_Reversal] = TRUE()))",
          "format": "#,0",
          "description": "Magnitude of merchandise units on negative cancellation/reversal lines. Not verified physical returned units."
        },
        {
          "name": "Unidentified Net Sales",
          "expression": "CALCULATE([Net Sales], KEEPFILTERS(ISBLANK(\u0027Online Retail\u0027[Customer_ID])))",
          "format": "\u00A3#,0.00;(\u00A3#,0.00);\u00A30.00",
          "description": "Net merchandise value where customer ID is blank. Included in commercial totals but not identified-customer rankings; GBP."
        },
        {
          "name": "Identified Sales Share",
          "expression": "DIVIDE(CALCULATE([Main Sales], KEEPFILTERS(NOT(ISBLANK(\u0027Online Retail\u0027[Customer_ID])))), [Main Sales])",
          "format": "0.00%;-0.00%;0.00%",
          "description": "Share of gross eligible merchandise sales with a known customer ID in the current context. Financial coverage, not share of all buyers."
        }
      ],
      "partitions": [
